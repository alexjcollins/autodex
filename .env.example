# Copy to .env.local and fill in when credentials are ready.
# Without these, the app runs in FALLBACK MODE (in-memory + guest auth).

# Supabase (Postgres)
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# WorkOS AuthKit
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_REDIRECT_URI=autodex://auth/callback

# Session signing (32+ random bytes, hex or base64). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Publicly exposed to the client
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_WORKOS_CLIENT_ID=
